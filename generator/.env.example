# Copy to .env and fill in values from terraform outputs.
# This file is safe to commit — it contains no real secrets.

BOOTSTRAP_SERVERS=<pkc-xxxxx.eu-central-1.aws.confluent.cloud:9092>
PRODUCER_API_KEY=<terraform output -raw producer_api_key>
PRODUCER_API_SECRET=<terraform output -raw producer_api_secret>
SCHEMA_REGISTRY_URL=<terraform output -raw schema_registry_url>
SCHEMA_REGISTRY_API_KEY=<terraform output -raw schema_registry_api_key>
SCHEMA_REGISTRY_API_SECRET=<terraform output -raw schema_registry_api_secret>
